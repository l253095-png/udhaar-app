PORT=3000
JWT_SECRET=change_this_to_a_long_random_string
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./config/service-account-key.json

# Password required to Undo/Reset a day's sync (a destructive action).
# Change this if you want, but the app currently expects: undosheet
UNDO_PASSWORD=undosheet
